# URL publique de l'app (sans / final) : sert au callback OAuth et aux liens d'invitation
APP_URL=http://localhost:3000

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Strava > Settings > My API Application
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# 2e app Strava (créée par Christelle) : mêmes réglages, capacité 10 de plus
STRAVA_CLIENT_ID_2=
STRAVA_CLIENT_SECRET_2=
# Places par app avant de basculer sur la suivante
STRAVA_APP_CAPACITY=10
# Chaîne libre choisie par toi, réutilisée lors de la création de l'abonnement webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=runz-webhook
# Ids des abonnements webhook, un par app, séparés par des virgules (facultatif)
STRAVA_SUBSCRIPTION_ID=
# activity:read_all inclut les activités "Moi uniquement" ; activity:read sinon
STRAVA_SCOPE=activity:read_all

# Secrets de l'app : openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=
ADMIN_PASSWORD=
