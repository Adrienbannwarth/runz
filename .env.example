# URL publique de l'app (sans / final) : sert au callback OAuth et aux liens d'invitation
APP_URL=http://localhost:3000

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Strava > Settings > My API Application
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Chaîne libre choisie par toi, réutilisée lors de la création de l'abonnement webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=runz-webhook
# Renseigné après création de l'abonnement webhook (facultatif, filtre les événements)
STRAVA_SUBSCRIPTION_ID=
# activity:read_all inclut les activités "Moi uniquement" ; activity:read sinon
STRAVA_SCOPE=activity:read_all

# Secrets de l'app : openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=
ADMIN_PASSWORD=
